<UserControl
    x:Class="RisaBotApp.Controls.SensorDotRow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    x:Name="Root">

    <!--
        One line of the sensor list: label on the left, a coloured dot and a word on the right.
        Ten of these stack into the sensor card.

        No divider line, unlike the web version. There it is a bottom border cancelled on the
        last child by :last-child, which has no WPF equivalent short of the card knowing its
        own row count; the rows are close enough together that spacing alone separates them.

        The dot in the web version carries a box-shadow glow, which costs nothing in CSS but
        would be ten live render-thread effects here. At 10px the saturated fill reads clearly
        enough on navy without it.
    -->

    <Grid Margin="0,5">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <TextBlock
            Grid.Column="0"
            Text="{Binding Label, ElementName=Root}"
            Style="{StaticResource MutedText}"
            FontSize="12"
            VerticalAlignment="Center"
            TextTrimming="CharacterEllipsis" />

        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
            <Ellipse
                x:Name="Dot"
                Width="10" Height="10"
                VerticalAlignment="Center"
                Margin="0,0,6,0" />
            <TextBlock
                x:Name="ValueText"
                FontSize="12"
                FontWeight="SemiBold"
                VerticalAlignment="Center"
                Foreground="{StaticResource TextPrimary}" />
        </StackPanel>
    </Grid>
</UserControl>
