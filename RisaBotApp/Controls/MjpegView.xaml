<UserControl
    x:Class="RisaBotApp.Controls.MjpegView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="#FAF5F6">

    <Grid>
        <!-- The decoded frame. Uniform keeps the 4:3 Astra aspect inside a 16:9 pane. -->
        <Image
            x:Name="FrameImage"
            Stretch="Uniform"
            RenderOptions.BitmapScalingMode="LowQuality" />

        <!--
            Placeholder shown until the first frame lands, and again whenever the feed
            stalls or errors. Sits above the Image on purpose: on a stall the last good
            frame stays visible underneath, dimmed, which reads better than a black pane.
        -->
        <Border
            x:Name="OverlayPanel"
            Background="#EEFAF5F6">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                <TextBlock
                    x:Name="OverlayTitle"
                    Text="Camera offline"
                    FontFamily="{StaticResource FontSemiBold}"
                    FontSize="15"
                    HorizontalAlignment="Center"
                    Foreground="{StaticResource TextPrimary}" />
                <TextBlock
                    x:Name="OverlayDetail"
                    Text="Start the system to bring the feed up."
                    Style="{StaticResource MutedText}"
                    Margin="0,6,0,0"
                    MaxWidth="320"
                    TextAlignment="Center"
                    TextWrapping="Wrap" />
            </StackPanel>
        </Border>

        <!-- Frame-rate readout. The whole point of decoding in-process rather than
             handing the URL to a WebView and hoping. -->
        <Border
            x:Name="StatsBadge"
            HorizontalAlignment="Right"
            VerticalAlignment="Top"
            Margin="12"
            Padding="9,4"
            CornerRadius="7"
            Background="#DDFAF5F6"
            Visibility="Collapsed">
            <StackPanel Orientation="Horizontal">
                <Ellipse
                    x:Name="LiveDot"
                    Width="6" Height="6"
                    VerticalAlignment="Center"
                    Fill="{StaticResource AccentGreen}" />
                <TextBlock
                    x:Name="StatsText"
                    Text="0 fps"
                    FontSize="11"
                    Margin="7,0,0,0"
                    VerticalAlignment="Center"
                    Foreground="{StaticResource TextPrimary}" />
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
