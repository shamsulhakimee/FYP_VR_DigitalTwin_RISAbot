<UserControl
    x:Class="RisaBotApp.Views.WifiSetupView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="{StaticResource PageBackground}">

    <!--
        Second half of the pre-pairing flow, so still no sidebar, and laid out to the same
        shape as Discovery: identity strip, title, the candidates, and a committed action bar
        pinned to the bottom. Two screens in a row that ask "pick one of these" should not
        disagree about where the answer button lives.

        The candidates are a table with a detail panel beside it, not a list of expanding
        rows. Both earlier shapes had the same fault from opposite ends: the original put a
        progress card on the right and the password in it but left the *network* on the left,
        so the two halves of one decision sat apart; the expanding row fixed that and created
        a worse one, because opening a row shoves every row below it down by about 120px, and
        on a fourteen-network list the thing you just clicked walks out from under the pointer.

        A panel holds still. The table never reflows, the chosen row stays exactly where it
        was clicked with a lit outline around it, and everything about that one network —
        strength, security, the password, the connect button, and the steps once it is
        running — is in one column that appears beside it.
    -->

    <UserControl.Resources>

        <!--
            The padlock geometry that used to live here is gone with the row that carried it.
            It marked every secured network, which on a real list is very nearly all of them
            — an icon drawn on the rule rather than the exception, costing a column and
            saying no more than the chip now sitting at the right edge already does.

            The signal percentage went the same way *in the row*. Four bars and a number are
            one fact twice at that size; the number survives in the panel, where there is
            room for it to be the headline rather than a fifth column.
        -->

        <!--
            Step outcomes. ✓ and ✕ were text before, which meant the two marks came from
            whichever installed font happened to carry U+2713 and U+2715 — not the UI face,
            which carries neither — so they arrived at a weight and a size nothing on the
            screen had asked for. Drawn, they inherit the theme brush and scale with the
            Viewbox like every other glyph in this app.
        -->
        <PathGeometry x:Key="TickGlyph" Figures="M 1.5,6.2 L 4.4,9 L 10.5,2.6" />
        <PathGeometry x:Key="CrossGlyph" Figures="M 2.4,2.4 L 9.6,9.6 M 9.6,2.4 L 2.4,9.6" />
        <PathGeometry x:Key="CloseGlyph" Figures="M 1,1 L 9,9 M 9,1 L 1,9" />

        <!--
            One signal bar. Four of these sit on a shared baseline at increasing heights;
            each is dimmed to a ghost when its own Bar* flag is false, so the indicator
            always occupies the same width and the rows stay in a column no matter how weak
            the reception is. Dimming rather than hiding is the point — an empty slot would
            let a 1-bar row's name start further left than a 4-bar row's.
        -->
        <Style x:Key="SignalBar" TargetType="Rectangle">
            <Setter Property="Width" Value="3" />
            <Setter Property="RadiusX" Value="1.5" />
            <Setter Property="RadiusY" Value="1.5" />
            <Setter Property="Margin" Value="0,0,2,0" />
            <Setter Property="VerticalAlignment" Value="Bottom" />
            <Setter Property="Fill" Value="{StaticResource AccentBlue}" />
        </Style>

        <!--
            One style per bar rather than one style and a converter. A DataTrigger's Binding
            is fixed at the point the style is declared, so "dim unless Bar3" cannot be
            expressed once and pointed at a different property four times — and three
            four-line styles are less machinery than a converter registered app-wide for a
            single indicator on a single screen.

            The first bar has no style of its own: one bar is the floor of SignalBars, so it
            is lit on every row that exists at all.
        -->
        <Style x:Key="SignalBar2" TargetType="Rectangle" BasedOn="{StaticResource SignalBar}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding Bar2}" Value="False">
                    <Setter Property="Opacity" Value="0.2" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="SignalBar3" TargetType="Rectangle" BasedOn="{StaticResource SignalBar}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding Bar3}" Value="False">
                    <Setter Property="Opacity" Value="0.2" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="SignalBar4" TargetType="Rectangle" BasedOn="{StaticResource SignalBar}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding Bar4}" Value="False">
                    <Setter Property="Opacity" Value="0.2" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- The same meter at panel scale. Only the width and gap change; the dimming rules
             are inherited, so the two indicators cannot drift apart. -->
        <Style x:Key="BigSignalBar" TargetType="Rectangle" BasedOn="{StaticResource SignalBar}">
            <Setter Property="Width" Value="4" />
            <Setter Property="Margin" Value="0,0,3,0" />
        </Style>

        <Style x:Key="BigSignalBar2" TargetType="Rectangle" BasedOn="{StaticResource BigSignalBar}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding Bar2}" Value="False">
                    <Setter Property="Opacity" Value="0.2" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="BigSignalBar3" TargetType="Rectangle" BasedOn="{StaticResource BigSignalBar}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding Bar3}" Value="False">
                    <Setter Property="Opacity" Value="0.2" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="BigSignalBar4" TargetType="Rectangle" BasedOn="{StaticResource BigSignalBar}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding Bar4}" Value="False">
                    <Setter Property="Opacity" Value="0.2" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!--
            Security chip. A bordered token rather than loose text, because it is the only
            other thing in the row and a bare word at the right margin reads as a stray
            fragment of the name. Outlined and unfilled: it is a label, not a control, and a
            filled pill this small starts to look pressable.
        -->
        <Style x:Key="SecurityChip" TargetType="Border">
            <Setter Property="BorderBrush" Value="{StaticResource Divider}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="Padding" Value="7,2" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
        </Style>

        <Style x:Key="SecurityChipText" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource FontMono}" />
            <Setter Property="FontSize" Value="10" />
            <Setter Property="Foreground" Value="{StaticResource TextMuted}" />
            <Setter Property="TextWrapping" Value="NoWrap" />
        </Style>

        <!-- Column heading over the table. Same face and size as the chips underneath it,
             which is what makes the strip read as a header rather than as a first row. -->
        <Style x:Key="ColumnHead" TargetType="TextBlock" BasedOn="{StaticResource SecurityChipText}">
            <Setter Property="Opacity" Value="0.55" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <!-- Left-hand label in the panel's fact list. -->
        <Style x:Key="MetaKey" TargetType="TextBlock" BasedOn="{StaticResource MutedText}">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Opacity" Value="0.8" />
            <Setter Property="TextWrapping" Value="NoWrap" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <!-- Right-hand value. Mono, because every one of them is machine-reported. -->
        <Style x:Key="MetaValue" TargetType="TextBlock" BasedOn="{StaticResource BodyText}">
            <Setter Property="FontFamily" Value="{StaticResource FontMono}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="HorizontalAlignment" Value="Right" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="TextWrapping" Value="NoWrap" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>

        <!-- Footer link, same as Discovery's: a text run that behaves like a button,
             unpainted until hovered so it reads as available rather than as the thing
             to press. -->
        <Style x:Key="FooterLink" TargetType="Button">
            <Setter Property="FontFamily" Value="{StaticResource FontRegular}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Foreground" Value="{StaticResource TextMuted}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Padding" Value="0,0,22,0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="Transparent" Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4" />
                                <Setter Property="Cursor" Value="Arrow" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- The panel's ✕. Drawn, not typed, for the same reason the tick and cross are. -->
        <Style x:Key="PanelCloseButton" TargetType="Button">
            <Setter Property="Width" Value="26" />
            <Setter Property="Height" Value="26" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root" Background="Transparent" CornerRadius="6">
                            <Viewbox Width="10" Height="10">
                                <Path x:Name="Glyph"
                                      Data="{StaticResource CloseGlyph}"
                                      Stroke="{StaticResource TextMuted}"
                                      StrokeThickness="1.4"
                                      StrokeStartLineCap="Round"
                                      StrokeEndLineCap="Round" />
                            </Viewbox>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="#14FFFFFF" />
                                <Setter TargetName="Glyph" Property="Stroke" Value="{StaticResource TextPrimary}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.3" />
                                <Setter Property="Cursor" Value="Arrow" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />   <!-- identity strip -->
            <RowDefinition Height="Auto" />   <!-- title          -->
            <RowDefinition Height="*" />      <!-- table + panel  -->
            <RowDefinition Height="Auto" />   <!-- action bar     -->
        </Grid.RowDefinitions>

        <!-- ══════════════ identity strip ═════════════════════════════════ -->
        <Grid Grid.Row="0" Margin="28,22,28,0">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Ellipse
                    x:Name="ScanDot"
                    Width="8" Height="8"
                    VerticalAlignment="Center"
                    Fill="{StaticResource AccentGreen}" />

                <TextBlock
                    Text="RISA-STUDIO"
                    FontFamily="{StaticResource FontDisplay}"
                    FontSize="12"
                    Margin="10,0,0,0"
                    VerticalAlignment="Center">
                    <TextBlock.Foreground>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0.6">
                            <GradientStop Color="{StaticResource IceHighColor}" Offset="0.0" />
                            <GradientStop Color="{StaticResource IceMidColor}"  Offset="1.0" />
                        </LinearGradientBrush>
                    </TextBlock.Foreground>
                </TextBlock>
            </StackPanel>

            <TextBlock
                Text="{Binding AppVersion, StringFormat='v{0}'}"
                Style="{StaticResource MutedText}"
                FontSize="11"
                HorizontalAlignment="Right"
                VerticalAlignment="Center" />
        </Grid>

        <!-- ══════════════ title ══════════════════════════════════════════ -->
        <StackPanel Grid.Row="1" Margin="28,40,28,0">
            <TextBlock Text="Network Setup" Style="{StaticResource PageTitle}" />

            <!--
                Worth spelling out, because the obvious fear at this point is that telling
                the robot to join another network will take it away from this laptop. It
                does not: the robot keeps its own access point running while wlan0 joins the
                chosen network, so this machine holds its 192.168.4.x lease and reaches the
                internet through the robot from then on.
            -->
            <TextBlock
                Text="Pick the network the robot should join, or carry on if it already has one. It keeps its own hotspot up either way, so this laptop stays connected to the robot — and picks up internet through it."
                Style="{StaticResource MutedText}"
                Margin="0,10,0,0"
                TextWrapping="Wrap"
                MaxWidth="640"
                HorizontalAlignment="Left" />

            <!--
                What the robot says about its own network, read from /api/status before the
                scan. This is the line that makes the screen worth passing through every time
                rather than only on a fresh robot: on a robot that is already online it says
                so and the footer offers to move on, and on one that is not it says that
                instead. Green when there is an uplink, so the two cases are distinguishable
                without reading — the same green as the liveness dot above.
            -->
            <TextBlock
                Text="{Binding UplinkHint}"
                FontFamily="{StaticResource FontMono}"
                FontSize="12"
                Margin="0,14,0,0"
                TextWrapping="Wrap">
                <TextBlock.Style>
                    <Style TargetType="TextBlock" BasedOn="{StaticResource MutedText}">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding HasUplink}" Value="True">
                                <Setter Property="Foreground" Value="{StaticResource AccentGreen}" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>

            <TextBlock
                Text="{Binding StatusHint}"
                Style="{StaticResource MutedText}"
                FontFamily="{StaticResource FontMono}"
                FontSize="12"
                Margin="0,6,0,0"
                TextWrapping="Wrap" />

            <!-- Errors sit under the subtitle rather than in a box of their own, for the
                 same reason they do on Discovery: there is nothing else on screen to
                 compete with, and a boxed error would push the list down by its height. -->
            <TextBlock
                Text="{Binding ErrorMessage}"
                Foreground="{StaticResource ErrorText}"
                FontFamily="{StaticResource FontMono}"
                FontSize="12"
                Margin="0,8,0,0"
                TextWrapping="Wrap"
                Visibility="{Binding HasError, Converter={StaticResource BoolToVisibility}}" />
        </StackPanel>

        <!-- ══════════════ network table + detail panel ═══════════════════ -->
        <Grid Grid.Row="2" Margin="0,20,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!--
                16, against the page's 28. The difference is deliberate and is split between
                two things that have to sit outside the text: the selection outline, which
                runs around the whole row, and the hairline dividers, which read as a table
                only if they run slightly wider than the words they separate. Each row then
                insets its own content by 12, so names land at 28 — flush under the title.
            -->
            <Grid Grid.Column="0" Margin="16,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />   <!-- column heads -->
                    <RowDefinition Height="*" />      <!-- rows         -->
                </Grid.RowDefinitions>

                <!--
                    Column heads. Three words that would be noise on a two-column list earn
                    their line here because the right-hand column is a chip whose content
                    varies — "open", "wpa2", "wpa1 wpa2" — and a reader who has not been told
                    what that column is will try to read it as part of the name.

                    Above the ScrollViewer rather than inside it, or they would scroll away
                    from the thing they label.
                -->
                <Grid Grid.Row="0" Height="24" Margin="12,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0" Text="sig"  Width="22" Style="{StaticResource ColumnHead}" />
                    <TextBlock Grid.Column="1" Text="ssid" Margin="14,0,16,0" Style="{StaticResource ColumnHead}" />
                    <TextBlock Grid.Column="2" Text="sec"  TextAlignment="Right" Style="{StaticResource ColumnHead}" />
                </Grid>

                <Border
                    Grid.Row="0"
                    Height="1"
                    Margin="12,0"
                    VerticalAlignment="Bottom"
                    Background="{StaticResource Divider}" />

                <ScrollViewer Grid.Row="1" Style="{StaticResource DarkScrollViewer}">
                    <!--
                        VerticalScrollBarVisibility=Disabled turns off the ListBox's own
                        scroller so the outer one does the work — otherwise the inner one
                        bounds the list to the viewport and does its scrolling with the stock
                        light-grey WPF scrollbar that DarkScrollViewer cannot reach.

                        IsHitTestVisible goes false while a join is running, so the table
                        cannot be re-pointed at another network halfway through provisioning
                        this one. The panel stays live, which is where the steps are.
                    -->
                    <ListBox
                        x:Name="NetworkTable"
                        Style="{StaticResource FlatRowListBox}"
                        ScrollViewer.VerticalScrollBarVisibility="Disabled"
                        ItemsSource="{Binding Networks}"
                        SelectedItem="{Binding SelectedNetwork, Mode=TwoWay}"
                        IsHitTestVisible="{Binding IsConnecting, Converter={StaticResource InvertBool}}">

                        <!--
                            Enter is scoped to the table rather than set as IsDefault on the
                            connect button, so it does not fire from unrelated focus; the
                            password field raises it separately once it has pushed its value
                            across to the view-model.
                        -->
                        <ListBox.InputBindings>
                            <KeyBinding Key="Return" Command="{Binding JoinSelectedCommand}" />
                        </ListBox.InputBindings>

                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <!--
                                    46 fixed rather than padding-driven, and one line only.
                                    A table's worth of rows has to be scannable as a column of
                                    names, and names at an even pitch is most of what makes
                                    that work; letting the height fall out of content means a
                                    row with a longer security string is imperceptibly taller
                                    than its neighbour and the column stops feeling ruled.
                                -->
                                <Grid Height="46" Margin="12,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />   <!-- signal   -->
                                        <ColumnDefinition Width="*" />      <!-- name     -->
                                        <ColumnDefinition Width="Auto" />   <!-- security -->
                                    </Grid.ColumnDefinitions>

                                    <!-- Fixed height so the baseline is the same on every row
                                         regardless of how many bars are lit. -->
                                    <StackPanel
                                        Grid.Column="0"
                                        Orientation="Horizontal"
                                        Height="14"
                                        Width="22"
                                        VerticalAlignment="Center">
                                        <Rectangle Height="4"  Style="{StaticResource SignalBar}" />
                                        <Rectangle Height="7"  Style="{StaticResource SignalBar2}" />
                                        <Rectangle Height="10" Style="{StaticResource SignalBar3}" />
                                        <Rectangle Height="13" Style="{StaticResource SignalBar4}" />
                                    </StackPanel>

                                    <Grid Grid.Column="1" Margin="14,0,16,0" VerticalAlignment="Center">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>

                                        <!--
                                            The network the robot is on already. Collapsed on
                                            every other row, so it costs nothing there — and
                                            it is the one piece of context the list cannot
                                            otherwise give you, since the usual reason to be
                                            on this screen is to move the robot off it.
                                        -->
                                        <Ellipse
                                            Grid.Column="0"
                                            Width="6" Height="6"
                                            Margin="0,0,9,0"
                                            VerticalAlignment="Center"
                                            Fill="{StaticResource AccentGreen}"
                                            Visibility="{Binding IsCurrent, Converter={StaticResource BoolToVisibility}}" />

                                        <TextBlock
                                            Grid.Column="1"
                                            Text="{Binding Ssid}"
                                            FontFamily="{StaticResource FontSemiBold}"
                                            FontSize="14"
                                            Foreground="{StaticResource TextPrimary}"
                                            TextTrimming="CharacterEllipsis"
                                            VerticalAlignment="Center" />
                                    </Grid>

                                    <Border Grid.Column="2" Style="{StaticResource SecurityChip}">
                                        <TextBlock
                                            Text="{Binding SecurityBadge}"
                                            Style="{StaticResource SecurityChipText}" />
                                    </Border>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </ScrollViewer>
            </Grid>

            <!-- ══════════ detail panel ══════════════════════════════════ -->
            <!--
                Collapsed until a row is picked, so with nothing selected the table runs the
                full width of the window and the screen looks exactly like the plain list it
                was. The column is Auto, so a collapsed panel measures zero and leaves no gap.

                This does move the table 330px on the first click, which is the reflow the
                expanding row was abandoned for. It is a different thing here: it happens on
                the axis the rows are *not* read along, so a name stays on its own line at its
                own height — where the expanding row pushed rows vertically past the pointer.
                The slide-in below is what makes it read as the panel arriving rather than as
                the list jumping.
            -->
            <Border
                Grid.Column="1"
                Width="330"
                Background="{StaticResource SidebarBackground}"
                BorderBrush="{StaticResource Divider}"
                BorderThickness="1,0,0,0"
                Visibility="{Binding HasSelection, Converter={StaticResource BoolToVisibility}}">

                <!--
                    Driven from code-behind, not from a trigger here. A DataTrigger on
                    HasSelection would have to live in a Style, and a Style has no namescope,
                    so Storyboard.TargetName cannot see this transform from there; the only
                    element-level trigger that can is an EventTrigger, and visibility does not
                    raise a routed event to hang one on. See WifiSetupView.xaml.cs.
                -->
                <Border.RenderTransform>
                    <TranslateTransform x:Name="PanelSlide" X="0" />
                </Border.RenderTransform>

                <Grid>
                    <ScrollViewer Style="{StaticResource DarkScrollViewer}">

                        <StackPanel Margin="22,20,22,24">

                            <!-- ── header ────────────────────────────────── -->
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <TextBlock
                                    Grid.Column="0"
                                    Text="{Binding SelectedNetwork.Ssid}"
                                    FontFamily="{StaticResource FontSemiBold}"
                                    FontSize="16"
                                    Foreground="{StaticResource TextPrimary}"
                                    TextTrimming="CharacterEllipsis"
                                    VerticalAlignment="Center"
                                    Margin="0,0,8,0" />

                                <!-- Disabled mid-join: the panel is the only place the steps
                                     are drawn, and dismissing it would leave a provisioning
                                     run in flight with nothing on screen reporting it. -->
                                <Button
                                    Grid.Column="1"
                                    Style="{StaticResource PanelCloseButton}"
                                    Command="{Binding ClearSelectionCommand}"
                                    ToolTip="close" />
                            </Grid>

                            <Border
                                Style="{StaticResource SecurityChip}"
                                HorizontalAlignment="Left"
                                Margin="0,10,0,0">
                                <TextBlock
                                    Text="{Binding SelectedNetwork.SecurityBadge}"
                                    Style="{StaticResource SecurityChipText}" />
                            </Border>

                            <Border Height="1" Background="{StaticResource Divider}" Margin="0,18,0,0" />

                            <!-- ── signal readout ────────────────────────── -->
                            <!--
                                The percentage comes back here, big, because in the panel it
                                is the headline rather than a fifth column competing with the
                                name. DataContext is pushed down to the selected item so the
                                shared Bar* triggers resolve — they are declared against a
                                WifiNetworkItem and the panel's own context is the view-model.
                            -->
                            <Border
                                Background="{StaticResource CardBackground}"
                                CornerRadius="10"
                                Padding="0,18"
                                Margin="0,18,0,0">
                                <StackPanel
                                    HorizontalAlignment="Center"
                                    DataContext="{Binding DataContext.SelectedNetwork,
                                                          RelativeSource={RelativeSource AncestorType=UserControl}}">
                                    <StackPanel
                                        Orientation="Horizontal"
                                        Height="18"
                                        HorizontalAlignment="Center">
                                        <Rectangle Height="6"  Style="{StaticResource BigSignalBar}" />
                                        <Rectangle Height="10" Style="{StaticResource BigSignalBar2}" />
                                        <Rectangle Height="14" Style="{StaticResource BigSignalBar3}" />
                                        <Rectangle Height="18" Style="{StaticResource BigSignalBar4}" />
                                    </StackPanel>

                                    <TextBlock
                                        Text="{Binding SignalLabel}"
                                        FontFamily="{StaticResource FontMono}"
                                        FontSize="28"
                                        Foreground="{StaticResource AccentBlue}"
                                        HorizontalAlignment="Center"
                                        Margin="0,10,0,0" />

                                    <TextBlock
                                        Text="signal strength"
                                        Style="{StaticResource MutedText}"
                                        FontFamily="{StaticResource FontMono}"
                                        FontSize="10"
                                        Opacity="0.6"
                                        HorizontalAlignment="Center"
                                        Margin="0,2,0,0" />
                                </StackPanel>
                            </Border>

                            <!-- ── facts ─────────────────────────────────── -->
                            <!--
                                Two rows, not the five a network inspector would carry. The
                                robot's scan reports SSID, a 0–100 signal and a security
                                string and nothing else — no BSSID, no frequency, no vendor —
                                so a Band or Vendor row here could only be invented.
                            -->
                            <Grid Margin="0,18,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="26" />
                                    <RowDefinition Height="26" />
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0" Grid.Column="0" Text="Security" Style="{StaticResource MetaKey}" />
                                <TextBlock Grid.Row="0" Grid.Column="1"
                                           Text="{Binding SelectedNetwork.SecurityLabel}"
                                           Style="{StaticResource MetaValue}" />

                                <TextBlock Grid.Row="1" Grid.Column="0" Text="Signal" Style="{StaticResource MetaKey}" />
                                <TextBlock Grid.Row="1" Grid.Column="1"
                                           Text="{Binding SelectedNetwork.SignalLabel}"
                                           Style="{StaticResource MetaValue}" />
                            </Grid>

                            <TextBlock
                                Text="the robot is on this network now"
                                FontFamily="{StaticResource FontMono}"
                                FontSize="11"
                                Foreground="{StaticResource AccentGreen}"
                                TextWrapping="Wrap"
                                Margin="0,4,0,0"
                                Visibility="{Binding SelectedNetwork.IsCurrent, Converter={StaticResource BoolToVisibility}}" />

                            <Border Height="1" Background="{StaticResource Divider}" Margin="0,18,0,0" />

                            <!--
                                Password. PasswordBox has no bindable Password property by
                                design, so the value crosses to the view-model in code-behind;
                                see WifiSetupView.xaml.cs. There is exactly one of these now —
                                it used to be one per row, each quietly holding whatever had
                                been typed into it before the user changed their mind.
                            -->
                            <StackPanel
                                Margin="0,18,0,0"
                                Visibility="{Binding SelectedIsSecured, Converter={StaticResource BoolToVisibility}}">
                                <TextBlock Text="Password" Style="{StaticResource FieldLabel}" Margin="0,0,0,3" />
                                <PasswordBox
                                    x:Name="NetworkPassword"
                                    Style="{StaticResource FlatPasswordBox}"
                                    PasswordChanged="NetworkPassword_PasswordChanged"
                                    KeyDown="NetworkPassword_KeyDown" />
                            </StackPanel>

                            <TextBlock
                                Text="open network — nothing to type"
                                Style="{StaticResource MutedText}"
                                FontFamily="{StaticResource FontMono}"
                                FontSize="11"
                                Opacity="0.7"
                                TextWrapping="Wrap"
                                Margin="0,18,0,0"
                                Visibility="{Binding SelectedIsOpen, Converter={StaticResource BoolToVisibility}}" />

                            <!-- The commit, next to the field it commits. Disabled until a
                                 secured network has a password typed; the template drops it
                                 to 35% opacity, which is what makes the panel read as
                                 waiting rather than as broken. -->
                            <Button
                                Content="connect"
                                Style="{StaticResource PrimaryButton}"
                                Margin="0,18,0,0"
                                Command="{Binding JoinSelectedCommand}" />

                            <!--
                                Step rail, vertical because the panel is tall and narrow —
                                the horizontal version was shaped for the full-width row this
                                replaced. Bound straight to Steps: the panel's DataContext is
                                the view-model, so nothing has to walk up the tree for it.
                            -->
                            <ItemsControl
                                ItemsSource="{Binding Steps}"
                                Margin="0,22,0,0"
                                Visibility="{Binding SelectedSsid, Converter={StaticResource StringNotEmptyToVisibility}}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,11">
                                            <!--
                                                Four glyphs stacked in one cell, each shown by
                                                its own Is* flag. Cheaper than a converter and
                                                it keeps the state machine readable in one
                                                place. The cell is a fixed 12px so the labels
                                                do not shuffle sideways as a dot becomes a tick.
                                            -->
                                            <Grid Width="12" VerticalAlignment="Center">
                                                <Ellipse
                                                    Width="8" Height="8"
                                                    Fill="{StaticResource Disabled}"
                                                    Visibility="{Binding IsPending, Converter={StaticResource BoolToVisibility}}" />
                                                <Ellipse
                                                    x:Name="ActiveDot"
                                                    Width="8" Height="8"
                                                    Fill="{StaticResource AccentOrange}"
                                                    Visibility="{Binding IsActive, Converter={StaticResource BoolToVisibility}}" />
                                                <Viewbox
                                                    Width="10" Height="10"
                                                    Visibility="{Binding IsDone, Converter={StaticResource BoolToVisibility}}">
                                                    <Path
                                                        Data="{StaticResource TickGlyph}"
                                                        Stroke="{StaticResource AccentGreen}"
                                                        StrokeThickness="1.6"
                                                        StrokeStartLineCap="Round"
                                                        StrokeEndLineCap="Round"
                                                        StrokeLineJoin="Round" />
                                                </Viewbox>
                                                <Viewbox
                                                    Width="9" Height="9"
                                                    Visibility="{Binding IsFailed, Converter={StaticResource BoolToVisibility}}">
                                                    <Path
                                                        Data="{StaticResource CrossGlyph}"
                                                        Stroke="{StaticResource ErrorText}"
                                                        StrokeThickness="1.6"
                                                        StrokeStartLineCap="Round"
                                                        StrokeEndLineCap="Round" />
                                                </Viewbox>
                                            </Grid>

                                            <TextBlock
                                                Text="{Binding Label}"
                                                Margin="9,0,0,0"
                                                VerticalAlignment="Center"
                                                FontSize="12">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock" BasedOn="{StaticResource BodyText}">
                                                        <Setter Property="Foreground" Value="{StaticResource TextMuted}" />
                                                        <Setter Property="Opacity" Value="0.7" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsActive}" Value="True">
                                                                <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
                                                                <Setter Property="FontFamily" Value="{StaticResource FontSemiBold}" />
                                                                <Setter Property="Opacity" Value="1" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding IsDone}" Value="True">
                                                                <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
                                                                <Setter Property="Opacity" Value="1" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding IsFailed}" Value="True">
                                                                <Setter Property="Foreground" Value="{StaticResource ErrorText}" />
                                                                <Setter Property="Opacity" Value="1" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </StackPanel>

                                        <!--
                                            The active step breathes, so a step that takes
                                            fifteen seconds still reads as running rather than
                                            as stuck. Driven off IsActive rather than off the
                                            view-model's IsConnecting, so exactly one dot is
                                            ever animating.
                                        -->
                                        <DataTemplate.Triggers>
                                            <DataTrigger Binding="{Binding IsActive}" Value="True">
                                                <DataTrigger.EnterActions>
                                                    <BeginStoryboard x:Name="PulseActive">
                                                        <Storyboard>
                                                            <DoubleAnimation
                                                                Storyboard.TargetName="ActiveDot"
                                                                Storyboard.TargetProperty="Opacity"
                                                                From="1" To="0.25" Duration="0:0:0.75"
                                                                AutoReverse="True" RepeatBehavior="Forever" />
                                                        </Storyboard>
                                                    </BeginStoryboard>
                                                </DataTrigger.EnterActions>
                                                <DataTrigger.ExitActions>
                                                    <StopStoryboard BeginStoryboardName="PulseActive" />
                                                </DataTrigger.ExitActions>
                                            </DataTrigger>
                                        </DataTemplate.Triggers>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>

        <!-- ══════════════ action bar ═════════════════════════════════════ -->
        <Border
            Grid.Row="3"
            Background="{StaticResource SidebarBackground}"
            BorderBrush="{StaticResource Divider}"
            BorderThickness="0,1,0,0">

            <StackPanel>
                <!-- The scan's own progress, as a hairline across the top of the bar. It
                     lives here rather than over the list because a bar above the rows
                     would reflow them every time a scan started or finished. -->
                <ProgressBar
                    Style="{StaticResource BusyBar}"
                    Height="2"
                    Visibility="{Binding IsScanning, Converter={StaticResource BoolToVisibility}}" />

                <Grid Margin="28,0" Height="76">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Button
                            Content="rescan"
                            Style="{StaticResource FooterLink}"
                            Command="{Binding ScanCommand}"
                            IsEnabled="{Binding IsConnecting, Converter={StaticResource InvertBool}}" />

                        <!--
                            The way past a screen that is now mandatory. Only shown when the
                            robot has no uplink — when it has one the button on the right
                            already reads "continue", and offering two ways through would
                            make the user choose between them for no reason.

                            The consequence is printed next to it rather than behind a
                            confirmation, because it is mild and specific: the robot loses
                            internet, not function. Everything this app does — driving, the
                            camera, telemetry — runs over the robot's own access point and is
                            unaffected. A modal would imply a graver choice than this is.
                        -->
                        <Button
                            Content="skip · use the robot offline"
                            Style="{StaticResource FooterLink}"
                            Command="{Binding SkipCommand}"
                            Visibility="{Binding HasUplink, Converter={StaticResource InvertBoolToVisibility}}" />

                        <TextBlock
                            Text="driving, camera and telemetry still work — only the robot's own internet is missing"
                            Style="{StaticResource MutedText}"
                            FontSize="11"
                            VerticalAlignment="Center"
                            Opacity="0.7"
                            Visibility="{Binding HasUplink, Converter={StaticResource InvertBoolToVisibility}}" />
                    </StackPanel>

                    <!--
                        Only the "continue" case. Joining moved into the panel, next to the
                        password it needs, and a second Join down here would be a button that
                        commits a decision made 400px away — the exact separation this layout
                        was rearranged to close. When a row is picked this disappears entirely
                        rather than greying out, because it is not disabled, it is irrelevant.
                    -->
                    <Button
                        Content="{Binding PrimaryActionLabel}"
                        Style="{StaticResource PrimaryButton}"
                        Width="180"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        Command="{Binding PrimaryActionCommand}"
                        Visibility="{Binding ShowContinue, Converter={StaticResource BoolToVisibility}}" />
                </Grid>
            </StackPanel>
        </Border>
    </Grid>

    <UserControl.Triggers>
        <!-- Breathes for as long as the screen is up, not just during a scan: it is a
             liveness indicator for the app, and stopping it once results land would read as
             the app having gone away rather than as the scan having finished. -->
        <EventTrigger RoutedEvent="Loaded">
            <BeginStoryboard>
                <Storyboard>
                    <DoubleAnimation
                        Storyboard.TargetName="ScanDot"
                        Storyboard.TargetProperty="Opacity"
                        From="1" To="0.25" Duration="0:0:0.9"
                        AutoReverse="True" RepeatBehavior="Forever" />
                </Storyboard>
            </BeginStoryboard>
        </EventTrigger>
    </UserControl.Triggers>
</UserControl>
