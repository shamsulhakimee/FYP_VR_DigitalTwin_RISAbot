<UserControl
    x:Class="RisaBotApp.Views.LogsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="{StaticResource PageBackground}">

    <Grid Margin="28,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />   <!-- header  -->
            <RowDefinition Height="Auto" />   <!-- summary -->
            <RowDefinition Height="*" />      <!-- lines   -->
        </Grid.RowDefinitions>

        <!-- ── Header ─────────────────────────────────────────────────────── -->
        <Grid Grid.Row="0">
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="Logs" Style="{StaticResource PageTitle}" />
                <TextBlock
                    Text="Recent journal output from the robot's launch unit."
                    Style="{StaticResource MutedText}"
                    Margin="0,6,0,0" />
            </StackPanel>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                <ToggleButton
                    x:Name="ErrorsOnlyToggle"
                    Style="{StaticResource ViewSwitchButton}"
                    Content="Errors only"
                    Checked="OnFilterChanged"
                    Unchecked="OnFilterChanged" />

                <Button
                    Content="Refresh"
                    Style="{StaticResource SecondaryButton}"
                    Width="120"
                    Command="{Binding LoadLogsCommand}" />
            </StackPanel>
        </Grid>

        <!-- ── Summary ────────────────────────────────────────────────────── -->
        <Border
            Grid.Row="1"
            Style="{StaticResource Card}"
            Padding="16,12"
            Margin="0,18,0,12"
            Visibility="{Binding LogsSummary, Converter={StaticResource StringNotEmptyToVisibility}}">
            <TextBlock
                Text="{Binding LogsSummary}"
                Style="{StaticResource BodyText}"
                FontFamily="{StaticResource FontMono}"
                FontSize="12"
                TextWrapping="Wrap" />
        </Border>

        <!-- ── Lines ──────────────────────────────────────────────────────── -->
        <Border Grid.Row="2" Style="{StaticResource Card}" Padding="6">
            <Grid>
                <!--
                    A ListBox rather than an ItemsControl in a ScrollViewer: journalctl can
                    return a few thousand lines, and the ListBox virtualises them. Selection
                    is left on so a line can be highlighted and copied.
                -->
                <ListBox
                    x:Name="LogList"
                    Style="{StaticResource PlainListBox}"
                    ItemsSource="{Binding Logs}"
                    VirtualizingPanel.IsVirtualizing="True"
                    VirtualizingPanel.VirtualizationMode="Recycling"
                    ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock
                                Text="{Binding Text}"
                                FontFamily="{StaticResource FontMono}"
                                FontSize="12"
                                Padding="10,3"
                                TextWrapping="Wrap"
                                Foreground="{Binding IsError, Converter={StaticResource BoolToBrush}, ConverterParameter='#C62828,#1C0810'}" />
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <!-- Style is set via the property element below, not as an attribute:
                     XAML rejects both, and the trigger needs the element form. -->
                <TextBlock
                    Text="No logs loaded yet. Hit Refresh."
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    IsHitTestVisible="False">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock" BasedOn="{StaticResource MutedText}">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Logs.Count}" Value="0">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </Grid>
        </Border>
    </Grid>
</UserControl>
