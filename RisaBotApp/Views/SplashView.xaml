<UserControl
    x:Class="RisaBotApp.Views.SplashView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="{StaticResource SplashBackground}">

    <!--
        Startup screen. Three layers, back to front:

          1. a static radial wash that lifts the centre of the window off the flat navy
          2. three blurred colour orbs drifting on long, staggered loops — the same
             floating-orb background the web dashboard runs behind its cards
          3. the wordmark, whose fill is a gradient that slides forever

        The gradient text is the dashboard's `.header h1` trick ported to WPF. CSS does it
        with background-clip:text over an animated background-position; WPF has no such
        clip, but a LinearGradientBrush used directly as Foreground already paints only
        the glyphs, so animating the brush is equivalent — and cheaper, since nothing is
        re-clipped per frame.
    -->
    <Grid ClipToBounds="True">

        <!-- ══════════════ 1 · centre wash ════════════════════════════════════ -->
        <Rectangle>
            <Rectangle.Fill>
                <RadialGradientBrush Center="0.5,0.42" GradientOrigin="0.5,0.42" RadiusX="0.75" RadiusY="0.75">
                    <GradientStop Color="#601020" Offset="0" />
                    <GradientStop Color="#3D0F1E" Offset="1" />
                </RadialGradientBrush>
            </Rectangle.Fill>
        </Rectangle>

        <!-- ══════════════ 2 · drifting orbs ══════════════════════════════════ -->
        <!--
            Soft edges come from the radial fill fading to fully transparent, not from a
            BlurEffect. A 60px blur over three 400px ellipses is a per-frame shader pass
            on the whole splash; the gradient costs nothing and is visually the same at
            this opacity. RenderTransformOrigin is centred so the scale breathes in place.
        -->
        <Ellipse
            x:Name="OrbOne"
            Width="520" Height="520"
            HorizontalAlignment="Left" VerticalAlignment="Top"
            Margin="-90,-140,0,0"
            Opacity="0.20"
            RenderTransformOrigin="0.5,0.5">
            <Ellipse.Fill>
                <RadialGradientBrush>
                    <GradientStop Color="{StaticResource BrandPinkColor}" Offset="0" />
                    <GradientStop Color="#0091102F" Offset="1" />
                </RadialGradientBrush>
            </Ellipse.Fill>
            <Ellipse.RenderTransform>
                <TransformGroup>
                    <ScaleTransform ScaleX="1" ScaleY="1" />
                    <TranslateTransform X="0" Y="0" />
                </TransformGroup>
            </Ellipse.RenderTransform>
        </Ellipse>

        <Ellipse
            x:Name="OrbTwo"
            Width="640" Height="640"
            HorizontalAlignment="Right" VerticalAlignment="Bottom"
            Margin="0,0,-160,-200"
            Opacity="0.28"
            RenderTransformOrigin="0.5,0.5">
            <Ellipse.Fill>
                <RadialGradientBrush>
                    <GradientStop Color="{StaticResource BrandDeepColor}" Offset="0" />
                    <GradientStop Color="#006B0E22" Offset="1" />
                </RadialGradientBrush>
            </Ellipse.Fill>
            <Ellipse.RenderTransform>
                <TransformGroup>
                    <ScaleTransform ScaleX="1" ScaleY="1" />
                    <TranslateTransform X="0" Y="0" />
                </TransformGroup>
            </Ellipse.RenderTransform>
        </Ellipse>

        <Ellipse
            x:Name="OrbThree"
            Width="380" Height="380"
            HorizontalAlignment="Center" VerticalAlignment="Center"
            Margin="360,180,0,0"
            Opacity="0.16"
            RenderTransformOrigin="0.5,0.5">
            <Ellipse.Fill>
                <RadialGradientBrush>
                    <GradientStop Color="{StaticResource BrandSkyColor}" Offset="0" />
                    <GradientStop Color="#00E8607A" Offset="1" />
                </RadialGradientBrush>
            </Ellipse.Fill>
            <Ellipse.RenderTransform>
                <TransformGroup>
                    <ScaleTransform ScaleX="1" ScaleY="1" />
                    <TranslateTransform X="0" Y="0" />
                </TransformGroup>
            </Ellipse.RenderTransform>
        </Ellipse>

        <!-- A slow diagonal sheen over the whole field. Repeat + a translate of exactly
             one period means the loop has no seam to hide. -->
        <Rectangle x:Name="Sheen" Opacity="0.5" IsHitTestVisible="False">
            <Rectangle.Fill>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0.45,0.85" SpreadMethod="Repeat">
                    <LinearGradientBrush.RelativeTransform>
                        <TranslateTransform X="0" Y="0" />
                    </LinearGradientBrush.RelativeTransform>
                    <GradientStop Color="#00FFFFFF" Offset="0.00" />
                    <GradientStop Color="#0AFFFFFF" Offset="0.50" />
                    <GradientStop Color="#00FFFFFF" Offset="1.00" />
                </LinearGradientBrush>
            </Rectangle.Fill>
        </Rectangle>

        <!-- ══════════════ 3 · wordmark ═══════════════════════════════════════ -->
        <StackPanel
            x:Name="HeroPanel"
            VerticalAlignment="Center"
            HorizontalAlignment="Center"
            Opacity="0"
            RenderTransformOrigin="0.5,0.5">

            <StackPanel.RenderTransform>
                <TranslateTransform X="0" Y="22" />
            </StackPanel.RenderTransform>

            <TextBlock
                x:Name="Wordmark"
                Text="RISA-STUDIO"
                FontFamily="{StaticResource FontDisplay}"
                FontSize="66"
                HorizontalAlignment="Center">
                <TextBlock.Foreground>
                    <!--
                        Five stops, symmetric about the middle and with the first and last
                        identical, over a half-width period with SpreadMethod=Repeat: sliding
                        the brush by exactly 0.5 returns it to where it started, so the
                        animation loops without a visible jump. The symmetry matters as well
                        as the endpoints — an asymmetric ramp reads as a highlight travelling
                        in one direction, which makes the wrap point findable even when the
                        colours line up.
                    -->
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0.5,0.28" SpreadMethod="Repeat">
                        <LinearGradientBrush.RelativeTransform>
                            <TranslateTransform X="0" Y="0" />
                        </LinearGradientBrush.RelativeTransform>
                        <GradientStop Color="{StaticResource IceHighColor}" Offset="0.00" />
                        <GradientStop Color="{StaticResource IceMidColor}"  Offset="0.28" />
                        <GradientStop Color="{StaticResource IceDeepColor}" Offset="0.50" />
                        <GradientStop Color="{StaticResource IceMidColor}"  Offset="0.72" />
                        <GradientStop Color="{StaticResource IceHighColor}" Offset="1.00" />
                    </LinearGradientBrush>
                </TextBlock.Foreground>
            </TextBlock>

            <!--
                Spinner. Two shapes: a faint full ring that never moves, and a 270° arc on
                top that does. The static ring is what keeps it from reading as a fragment
                skidding across empty space — the eye gets a fixed track to measure the
                motion against.

                Drawn as a Path rather than an Ellipse with StrokeDashArray: a dashed
                ellipse's gap lands wherever the geometry's start point happens to be and
                the dash length has to be re-derived from the circumference every time the
                size changes. The arc states its own sweep.
            -->
            <Grid
                x:Name="Spinner"
                Width="32" Height="32"
                Margin="0,30,0,0"
                Opacity="0"
                HorizontalAlignment="Center"
                RenderTransformOrigin="0.5,0.5">

                <Ellipse
                    Width="26" Height="26"
                    Stroke="{StaticResource Divider}"
                    StrokeThickness="3"
                    Opacity="0.7" />

                <!-- M 16,3: top of a 13px-radius circle centred at 16,16. Large-arc and
                     sweep both 1 — 270° the short way round is still the long arc. -->
                <Path
                    x:Name="SpinnerArc"
                    Data="M 16,3 A 13,13 0 1 1 3,16"
                    StrokeThickness="3"
                    StrokeStartLineCap="Round"
                    StrokeEndLineCap="Round"
                    RenderTransformOrigin="0.5,0.5">
                    <Path.Stroke>
                        <!-- Head bright, tail dark: the gradient rotates with the arc, so
                             the bright end always leads. -->
                        <LinearGradientBrush StartPoint="0.5,0" EndPoint="0.1,1">
                            <GradientStop Color="{StaticResource IceHighColor}" Offset="0.0" />
                            <GradientStop Color="{StaticResource IceDeepColor}" Offset="0.55" />
                            <GradientStop Color="#2291102F" Offset="1.0" />
                        </LinearGradientBrush>
                    </Path.Stroke>
                    <Path.RenderTransform>
                        <RotateTransform Angle="0" />
                    </Path.RenderTransform>
                </Path>
            </Grid>

        </StackPanel>
    </Grid>

    <UserControl.Triggers>
        <EventTrigger RoutedEvent="Loaded">
            <BeginStoryboard>
                <Storyboard>

                    <!-- ── content: fade and rise in ─────────────────────────── -->
                    <DoubleAnimation
                        Storyboard.TargetName="HeroPanel"
                        Storyboard.TargetProperty="Opacity"
                        From="0" To="1" Duration="0:0:0.9" />
                    <DoubleAnimation
                        Storyboard.TargetName="HeroPanel"
                        Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)"
                        From="22" To="0" Duration="0:0:0.9">
                        <DoubleAnimation.EasingFunction>
                            <CubicEase EasingMode="EaseOut" />
                        </DoubleAnimation.EasingFunction>
                    </DoubleAnimation>

                    <!-- ── wordmark: the gradient slide ──────────────────────── -->
                    <!--
                        Addressed by property path rather than by naming the brush: a
                        Freezable reached through a property path is cloned into an
                        unfrozen copy for the animation, whereas a StaticResource brush
                        shared with other elements would refuse to animate at all.
                    -->
                    <DoubleAnimation
                        Storyboard.TargetName="Wordmark"
                        Storyboard.TargetProperty="(TextBlock.Foreground).(LinearGradientBrush.RelativeTransform).(TranslateTransform.X)"
                        From="0" To="0.5" Duration="0:0:4"
                        RepeatBehavior="Forever" />

                    <!-- ── spinner ───────────────────────────────────────────── -->
                    <!--
                        Fades in half a second behind the wordmark rather than with it: the
                        name should land first and the spinner appear underneath it, which
                        reads as the app reporting progress. Arriving together reads as a
                        single busy screen.
                    -->
                    <DoubleAnimation
                        Storyboard.TargetName="Spinner"
                        Storyboard.TargetProperty="Opacity"
                        From="0" To="1" Duration="0:0:0.5"
                        BeginTime="0:0:0.55" />
                    <!-- Linear, and the whole 360: any easing makes the seam between
                         repeats visible as a stutter at the wrap. -->
                    <DoubleAnimation
                        Storyboard.TargetName="SpinnerArc"
                        Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)"
                        From="0" To="360" Duration="0:0:1.1"
                        RepeatBehavior="Forever" />

                    <!-- ── sheen: one period across, forever ─────────────────── -->
                    <DoubleAnimation
                        Storyboard.TargetName="Sheen"
                        Storyboard.TargetProperty="(Shape.Fill).(LinearGradientBrush.RelativeTransform).(TranslateTransform.X)"
                        From="0" To="0.45" Duration="0:0:14"
                        RepeatBehavior="Forever" />
                    <DoubleAnimation
                        Storyboard.TargetName="Sheen"
                        Storyboard.TargetProperty="(Shape.Fill).(LinearGradientBrush.RelativeTransform).(TranslateTransform.Y)"
                        From="0" To="0.85" Duration="0:0:14"
                        RepeatBehavior="Forever" />

                    <!-- ── orbs: long AutoReverse drifts, staggered ──────────── -->
                    <!--
                        Durations are deliberately coprime-ish (17/23/13 s) so the three
                        never resynchronise into an obvious pulse.
                    -->
                    <DoubleAnimation
                        Storyboard.TargetName="OrbOne"
                        Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[1].(TranslateTransform.Y)"
                        From="0" To="-64" Duration="0:0:17"
                        AutoReverse="True" RepeatBehavior="Forever" />
                    <DoubleAnimation
                        Storyboard.TargetName="OrbOne"
                        Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[0].(ScaleTransform.ScaleX)"
                        From="1" To="1.14" Duration="0:0:17"
                        AutoReverse="True" RepeatBehavior="Forever" />
                    <DoubleAnimation
                        Storyboard.TargetName="OrbOne"
                        Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[0].(ScaleTransform.ScaleY)"
                        From="1" To="1.14" Duration="0:0:17"
                        AutoReverse="True" RepeatBehavior="Forever" />

                    <DoubleAnimation
                        Storyboard.TargetName="OrbTwo"
                        Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[1].(TranslateTransform.Y)"
                        From="0" To="-52" Duration="0:0:23"
                        BeginTime="0:0:2"
                        AutoReverse="True" RepeatBehavior="Forever" />
                    <DoubleAnimation
                        Storyboard.TargetName="OrbTwo"
                        Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[1].(TranslateTransform.X)"
                        From="0" To="-40" Duration="0:0:23"
                        BeginTime="0:0:2"
                        AutoReverse="True" RepeatBehavior="Forever" />
                    <DoubleAnimation
                        Storyboard.TargetName="OrbTwo"
                        Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[0].(ScaleTransform.ScaleX)"
                        From="1.08" To="1" Duration="0:0:23"
                        BeginTime="0:0:2"
                        AutoReverse="True" RepeatBehavior="Forever" />
                    <DoubleAnimation
                        Storyboard.TargetName="OrbTwo"
                        Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[0].(ScaleTransform.ScaleY)"
                        From="1.08" To="1" Duration="0:0:23"
                        BeginTime="0:0:2"
                        AutoReverse="True" RepeatBehavior="Forever" />

                    <DoubleAnimation
                        Storyboard.TargetName="OrbThree"
                        Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[1].(TranslateTransform.Y)"
                        From="0" To="46" Duration="0:0:13"
                        BeginTime="0:0:5"
                        AutoReverse="True" RepeatBehavior="Forever" />
                    <DoubleAnimation
                        Storyboard.TargetName="OrbThree"
                        Storyboard.TargetProperty="Opacity"
                        From="0.16" To="0.26" Duration="0:0:13"
                        BeginTime="0:0:5"
                        AutoReverse="True" RepeatBehavior="Forever" />

                </Storyboard>
            </BeginStoryboard>
        </EventTrigger>
    </UserControl.Triggers>
</UserControl>
