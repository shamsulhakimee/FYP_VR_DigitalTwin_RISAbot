<Window
    x:Class="RisaBotApp.Views.Dialogs.PromptDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="RISA-Studio"
    Width="440"
    SizeToContent="Height"
    ResizeMode="NoResize"
    ShowInTaskbar="False"
    WindowStartupLocation="CenterOwner"
    Background="{StaticResource PageBackground}"
    FontFamily="{StaticResource FontRegular}">

    <Border Padding="26" Background="{StaticResource PageBackground}">
        <StackPanel>

            <TextBlock
                x:Name="TitleText"
                Style="{StaticResource CardTitle}"
                TextWrapping="Wrap" />

            <TextBlock
                x:Name="MessageText"
                Style="{StaticResource MutedText}"
                Margin="0,8,0,0"
                TextWrapping="Wrap" />

            <!--
                Both input controls are declared up front and one is collapsed, rather than
                built in code-behind. PasswordBox deliberately has no bindable Password
                property (WPF refuses to put a secret in the binding graph), so the two
                cannot share a control and the value is read out on OK instead.
            -->
            <!-- Not named TextInput: UIElement already has a TextInput event, and a
                 generated field of that name shadows it (CS0108). -->
            <TextBox
                x:Name="ValueInput"
                Style="{StaticResource DarkTextBox}"
                Margin="0,18,0,0" />

            <PasswordBox
                x:Name="PasswordInput"
                Style="{StaticResource DarkPasswordBox}"
                Margin="0,18,0,0"
                Visibility="Collapsed" />

            <StackPanel
                Orientation="Horizontal"
                HorizontalAlignment="Right"
                Margin="0,22,0,0">

                <Button
                    Content="Cancel"
                    Style="{StaticResource GhostButton}"
                    Width="104"
                    IsCancel="True"
                    Click="OnCancel" />

                <Button
                    Content="OK"
                    Style="{StaticResource PrimaryButton}"
                    Width="104"
                    Margin="10,0,0,0"
                    IsDefault="True"
                    Click="OnAccept" />

            </StackPanel>
        </StackPanel>
    </Border>
</Window>
