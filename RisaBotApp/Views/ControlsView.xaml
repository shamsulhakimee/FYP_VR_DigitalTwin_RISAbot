<UserControl
    x:Class="RisaBotApp.Views.ControlsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:RisaBotApp.Controls"
    Background="{StaticResource PageBackground}">

    <ScrollViewer Style="{StaticResource DarkScrollViewer}">
        <!-- Centred for the same reason as SettingsView: the width cap keeps the measure
             readable, and left-anchoring it on a wide window just stacks the whole page
             against the nav rail. See SettingsView.xaml for the full note. -->
        <Grid MaxWidth="820" HorizontalAlignment="Center" Margin="28,24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />   <!-- header  -->
                <RowDefinition Height="Auto" />   <!-- error   -->
                <RowDefinition Height="Auto" />   <!-- launch  -->
                <RowDefinition Height="Auto" />   <!-- run     -->
                <RowDefinition Height="Auto" />   <!-- service -->
            </Grid.RowDefinitions>

            <!-- ── Header ─────────────────────────────────────────────────── -->
            <StackPanel Grid.Row="0">
                <TextBlock Text="Controls" Style="{StaticResource PageTitle}" />
                <TextBlock
                    Text="Everything that changes the robot's state. Actions here take effect immediately."
                    Style="{StaticResource MutedText}"
                    Margin="0,6,0,0" />
            </StackPanel>

            <!-- ── Action error ───────────────────────────────────────────── -->
            <Border
                Grid.Row="1"
                Background="{StaticResource ErrorBackground}"
                CornerRadius="12"
                Padding="16,14"
                Margin="0,20,0,0"
                Visibility="{Binding ActionError, Converter={StaticResource StringNotEmptyToVisibility}}">
                <TextBlock
                    Text="{Binding ActionError}"
                    Foreground="{StaticResource ErrorText}"
                    TextWrapping="Wrap" />
            </Border>

            <!-- ── Launch ─────────────────────────────────────────────────── -->
            <Border Grid.Row="2" Style="{StaticResource Card}" Margin="0,20,0,0">
                <StackPanel>
                    <Grid>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="{Binding LaunchStatusText}" Style="{StaticResource CardTitle}" />
                            <TextBlock
                                Text="{Binding LaunchStatusDetail}"
                                Style="{StaticResource MutedText}"
                                Margin="0,6,0,0"
                                TextWrapping="Wrap" />
                        </StackPanel>

                        <Ellipse
                            Width="12" Height="12"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Top"
                            Margin="0,4,0,0"
                            controls:Animate.Fill="{Binding LaunchStatusColor, Converter={StaticResource StringToBrush}}" />
                    </Grid>

                    <ProgressBar
                        Style="{StaticResource BusyBar}"
                        Margin="0,16,0,0"
                        Visibility="{Binding IsLaunchTransitioning, Converter={StaticResource BoolToVisibility}}" />

                    <!--
                        The sidebar carries the same toggle so it is reachable from any
                        section; this one is the full-width version with the long label.
                        Both bind the same command, so CanExecute disables them together
                        during a transition.
                    -->
                    <Button
                        Style="{StaticResource BaseButton}"
                        Content="{Binding LaunchButtonText}"
                        Background="{Binding LaunchButtonColor, Converter={StaticResource StringToBrush}}"
                        Foreground="White"
                        HorizontalAlignment="Stretch"
                        Margin="0,16,0,0"
                        Command="{Binding ToggleLaunchCommand}" />
                </StackPanel>
            </Border>

            <!-- ── Run controls ───────────────────────────────────────────── -->
            <Border Grid.Row="3" Style="{StaticResource Card}" Margin="0,14,0,0">
                <StackPanel>
                    <TextBlock Text="Run" Style="{StaticResource CardTitle}" />
                    <TextBlock
                        Text="Competition state and odometry. These talk to the ROS dashboard node, so they only do anything while the system is running."
                        Style="{StaticResource MutedText}"
                        Margin="0,6,0,16"
                        TextWrapping="Wrap" />

                    <UniformGrid Columns="3">
                        <Button
                            Content="RESET RUN"
                            Style="{StaticResource WarningButton}"
                            Margin="0,0,8,0"
                            Command="{Binding SendCompetitionCommandCommand}"
                            CommandParameter="RESET"
                            IsEnabled="{Binding IsActionBusy, Converter={StaticResource InvertBool}}" />
                        <Button
                            Content="MARK LAP 1"
                            Style="{StaticResource SecondaryButton}"
                            Margin="4,0"
                            Command="{Binding SendCompetitionCommandCommand}"
                            CommandParameter="LAP1"
                            IsEnabled="{Binding IsActionBusy, Converter={StaticResource InvertBool}}" />
                        <Button
                            Content="MARK LAP 2"
                            Style="{StaticResource SecondaryButton}"
                            Margin="8,0,0,0"
                            Command="{Binding SendCompetitionCommandCommand}"
                            CommandParameter="LAP2"
                            IsEnabled="{Binding IsActionBusy, Converter={StaticResource InvertBool}}" />
                    </UniformGrid>

                    <Button
                        Content="RESET ODOMETRY"
                        Style="{StaticResource GhostButton}"
                        HorizontalAlignment="Stretch"
                        Margin="0,10,0,0"
                        Command="{Binding ResetOdometryCommand}"
                        IsEnabled="{Binding IsActionBusy, Converter={StaticResource InvertBool}}" />
                </StackPanel>
            </Border>

            <!-- ── Service ────────────────────────────────────────────────── -->
            <Border Grid.Row="4" Style="{StaticResource Card}" Margin="0,14,0,0">
                <StackPanel>
                    <TextBlock Text="Service" Style="{StaticResource CardTitle}" />
                    <TextBlock
                        Text="Restarting cycles the systemd unit. Expect the feed to drop for several seconds while the perception nodes reload."
                        Style="{StaticResource MutedText}"
                        Margin="0,6,0,16"
                        TextWrapping="Wrap" />

                    <Button
                        Content="RESTART ROS"
                        Style="{StaticResource DangerButton}"
                        HorizontalAlignment="Stretch"
                        Command="{Binding RestartRosCommand}"
                        IsEnabled="{Binding IsActionBusy, Converter={StaticResource InvertBool}}" />

                    <ProgressBar
                        Style="{StaticResource BusyBar}"
                        Margin="0,14,0,0"
                        Visibility="{Binding IsActionBusy, Converter={StaticResource BoolToVisibility}}" />
                </StackPanel>
            </Border>
        </Grid>
    </ScrollViewer>
</UserControl>
