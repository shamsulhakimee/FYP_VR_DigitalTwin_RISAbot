<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<!-- Desktop-only WPF companion app. The MAUI multi-target build (Android +   -->
		<!-- WinUI) was retired in favour of a single Windows desktop target: the      -->
		<!-- Android head had never been compiled and every operator runs Windows.     -->
		<TargetFramework>net10.0-windows</TargetFramework>

		<OutputType>WinExe</OutputType>
		<UseWPF>true</UseWPF>
		<RootNamespace>RisaBotApp</RootNamespace>
		<AssemblyName>RisaBotApp</AssemblyName>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>

		<Version>2.0.0</Version>
		<AssemblyVersion>2.0.0.0</AssemblyVersion>
		<FileVersion>2.0.0.0</FileVersion>
		<Product>RISA-Studio</Product>
		<Company>RISA</Company>

		<!-- App shortcut / taskbar icon -->
		<ApplicationIcon>risa.ico</ApplicationIcon>
	</PropertyGroup>

	<ItemGroup>
		<!-- Fonts are embedded as WPF resources and referenced by pack:// URI in     -->
		<!-- Themes/Fonts.xaml. Build action must be Resource, not Content.           -->
		<Resource Include="Resources\Fonts\*.ttf" />
		<!-- App icon embedded as a WPF resource (pack:// URI usable in Window.Icon)  -->
		<Resource Include="risa.ico" />
	</ItemGroup>

	<ItemGroup>
		<!-- MVVM source generators — ObservableObject, RelayCommand, etc.            -->
		<PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.0" />

		<!-- DI container. Same service registrations the MAUI host used, minus the   -->
		<!-- MAUI-specific builder.                                                   -->
		<PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.0" />
	</ItemGroup>

</Project>
