<Application
    x:Class="RisaBotApp.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:conv="clr-namespace:RisaBotApp.Converters">

    <!--
        No StartupUri: the main window is constructed by the DI container in
        App.OnStartup so it can be handed its view-models. Setting StartupUri here
        would have WPF new up a second, parameterless MainWindow behind its back.
    -->

    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!-- Order matters: Controls.xaml resolves brushes and fonts by
                     StaticResource, so both must already be merged. -->
                <ResourceDictionary Source="Themes/Colors.xaml" />
                <ResourceDictionary Source="Themes/Fonts.xaml" />
                <ResourceDictionary Source="Themes/Controls.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <!-- Converters are stateless and immutable, so one shared instance each. -->
            <conv:InvertBoolConverter                x:Key="InvertBool" />
            <conv:BoolToVisibilityConverter          x:Key="BoolToVisibility" />
            <conv:InvertBoolToVisibilityConverter    x:Key="InvertBoolToVisibility" />
            <conv:StringNotEmptyToVisibilityConverter x:Key="StringNotEmptyToVisibility" />
            <conv:StringNotEmptyConverter            x:Key="StringNotEmpty" />
            <conv:BoolToBrushConverter               x:Key="BoolToBrush" />
            <conv:StringToBrushConverter             x:Key="StringToBrush" />
            <conv:BoolToOnlineConverter              x:Key="BoolToOnline" />
            <conv:NullableBoolTextConverter          x:Key="NullableBoolText" />
            <conv:NullableBoolToBrushConverter       x:Key="NullableBoolToBrush" />
            <conv:EnumToBoolConverter                x:Key="EnumToBool" />
            <conv:MultiplyConverter                  x:Key="Multiply" />
            <conv:SignedMultiplyConverter            x:Key="SignedMultiply" />
            <conv:StateBadgeBackgroundConverter      x:Key="StateBadgeBackground" />
            <conv:StateBadgeForegroundConverter      x:Key="StateBadgeForeground" />
        </ResourceDictionary>
    </Application.Resources>
</Application>
