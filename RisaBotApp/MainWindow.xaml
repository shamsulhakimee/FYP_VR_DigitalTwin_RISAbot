<Window
    x:Class="RisaBotApp.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:RisaBotApp.Controls"
    Title="RISA-Studio"
    Icon="pack://application:,,,/risa.ico"
    Width="1360"
    Height="860"
    MinWidth="1240"
    MinHeight="700"
    WindowStartupLocation="CenterScreen"
    Background="{StaticResource PageBackground}"
    FontFamily="{StaticResource FontRegular}"
    TextOptions.TextFormattingMode="Ideal"
    TextOptions.TextRenderingMode="ClearType">

    <!--
        MinWidth went 1280 → 1120 when the 244px sidebar column was replaced by an overlay
        drawer, then back up to 1240 when the Data Logger tab landed.  The dashboard's
        three-column body (260 + 14 + 380 + 14 + 260 = 928) plus its margins (28 × 2 = 56)
        needs 984px, so the body is not what sets the floor — the top bar is.  Its fixed
        content (hamburger 52, brand ~150, ⚙ Params ~110, launch pill + button ~250,
        margins ~50) leaves the nav tabs' star column about 500px at 1120, and the five
        tabs now need ~530.  Adding a sixth means raising this number again.

        The sidebar is now an overlay that slides in from the left over a backdrop,
        giving the dashboard the full window width by default.  A slim top bar carries
        the hamburger toggle, inline nav tabs and the launch status pill so the most-
        used affordances are always one click away.
    -->

    <Grid>
        <Grid.RowDefinitions>
            <!-- Top bar: visible on post-pairing screens, collapsed on splash / discovery / wifi -->
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- ══════════════════ Top Bar ═══════════════════════════════════ -->

        <Border
            Grid.Row="0"
            Background="{StaticResource SidebarBackground}"
            BorderBrush="{StaticResource Divider}"
            BorderThickness="0,0,0,1"
            Visibility="{Binding Nav.IsShellVisible, Converter={StaticResource BoolToVisibility}}">

            <Grid Height="48">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />   <!-- hamburger -->
                    <ColumnDefinition Width="Auto" />   <!-- brand + robot -->
                    <ColumnDefinition Width="*" />      <!-- nav tabs -->
                    <ColumnDefinition Width="Auto" />   <!-- parameters toggle -->
                    <ColumnDefinition Width="Auto" />   <!-- launch status -->
                </Grid.ColumnDefinitions>

                <!-- Hamburger button -->
                <Button
                    Grid.Column="0"
                    Command="{Binding ToggleDrawerCommand}"
                    Background="Transparent"
                    BorderThickness="0"
                    Cursor="Hand"
                    Width="52" Height="48"
                    Padding="0"
                    FocusVisualStyle="{x:Null}">
                    <Grid Width="20" Height="14">
                        <Border Height="2" VerticalAlignment="Top"    Background="{StaticResource TextPrimary}" CornerRadius="1" />
                        <Border Height="2" VerticalAlignment="Center" Background="{StaticResource TextPrimary}" CornerRadius="1" />
                        <Border Height="2" VerticalAlignment="Bottom" Background="{StaticResource TextPrimary}" CornerRadius="1" />
                    </Grid>
                </Button>

                <!-- Brand + robot name -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,0,0">
                    <TextBlock
                        Text="RISA-STUDIO"
                        FontFamily="{StaticResource FontDisplay}"
                        FontSize="12"
                        VerticalAlignment="Center">
                        <TextBlock.Foreground>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0.6">
                                <GradientStop Color="{StaticResource IceHighColor}" Offset="0.0" />
                                <GradientStop Color="{StaticResource IceMidColor}"  Offset="1.0" />
                            </LinearGradientBrush>
                        </TextBlock.Foreground>
                    </TextBlock>

                    <Border Width="1" Height="20" Background="{StaticResource Divider}" Margin="14,0" />

                    <TextBlock
                        Text="{Binding Dashboard.RobotName}"
                        Style="{StaticResource MutedText}"
                        FontSize="12"
                        VerticalAlignment="Center"
                        TextTrimming="CharacterEllipsis"
                        MaxWidth="200" />
                </StackPanel>

                <!-- Nav tabs (inline, horizontal) -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="20,0">
                    <RadioButton
                        Style="{StaticResource ViewSwitchButton}"
                        GroupName="TopNav"
                        Content="Dashboard"
                        Command="{Binding ShowDashboardCommand}"
                        IsChecked="{Binding ActiveRoute, Mode=OneWay,
                                    Converter={StaticResource EnumToBool},
                                    ConverterParameter=Dashboard}" />
                    <RadioButton
                        Style="{StaticResource ViewSwitchButton}"
                        GroupName="TopNav"
                        Content="Controls"
                        Command="{Binding ShowControlsCommand}"
                        IsChecked="{Binding ActiveRoute, Mode=OneWay,
                                    Converter={StaticResource EnumToBool},
                                    ConverterParameter=Controls}" />
                    <RadioButton
                        Style="{StaticResource ViewSwitchButton}"
                        GroupName="TopNav"
                        Content="Map"
                        Command="{Binding ShowSlamCommand}"
                        IsChecked="{Binding ActiveRoute, Mode=OneWay,
                                    Converter={StaticResource EnumToBool},
                                    ConverterParameter=Slam}" />
                    <RadioButton
                        Style="{StaticResource ViewSwitchButton}"
                        GroupName="TopNav"
                        Content="Logs"
                        Command="{Binding ShowLogsCommand}"
                        IsChecked="{Binding ActiveRoute, Mode=OneWay,
                                    Converter={StaticResource EnumToBool},
                                    ConverterParameter=Logs}" />
                    <RadioButton
                        Style="{StaticResource ViewSwitchButton}"
                        GroupName="TopNav"
                        Content="Data Logger"
                        Command="{Binding ShowDataLoggerCommand}"
                        IsChecked="{Binding ActiveRoute, Mode=OneWay,
                                    Converter={StaticResource EnumToBool},
                                    ConverterParameter=DataLogger}" />
                    <RadioButton
                        Style="{StaticResource ViewSwitchButton}"
                        GroupName="TopNav"
                        Content="Settings"
                        Command="{Binding ShowSettingsCommand}"
                        IsChecked="{Binding ActiveRoute, Mode=OneWay,
                                    Converter={StaticResource EnumToBool},
                                    ConverterParameter=Settings}" />
                </StackPanel>

                <!--
                    Parameters drawer toggle.

                    A ToggleButton so the bar shows whether the drawer is open — the drawer
                    itself has no backdrop, so nothing else in the chrome would say. IsChecked
                    is OneWay and the click is handled by the command, same arrangement as the
                    nav tabs above: the toggle flips its own visual state, the command flips the
                    flag, and the binding reasserts the one that matters.
                -->
                <ToggleButton
                    Grid.Column="3"
                    Style="{StaticResource ViewSwitchButton}"
                    Content="⚙ Params"
                    Margin="0,0,14,0"
                    ToolTip="Live ROS parameter tuning"
                    Command="{Binding ToggleParametersCommand}"
                    IsChecked="{Binding IsParametersOpen, Mode=OneWay}" />

                <!--
                    Launch status pill and the START/STOP button beside it.

                    The button is here rather than only in the drawer footer on purpose.
                    Stopping the robot is the one time-critical action in the app, and a
                    drawer that has to be opened first puts it two clicks away from every
                    screen — which is exactly the phone layout this window was built to
                    improve on. The status dot answers "what is it doing", the button acts
                    on it; the drawer keeps its own copy for when it is already open.
                -->
                <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,18,0">
                    <!-- Animate.Fill cross-fades the dot between states instead of cutting.
                         The badge text beside it still changes on the same frame, so nothing
                         is delayed — the colour just stops flickering during Starting. -->
                    <Ellipse
                        Width="8" Height="8"
                        VerticalAlignment="Center"
                        controls:Animate.Fill="{Binding Dashboard.LaunchStatusColor,
                                                Converter={StaticResource StringToBrush}}" />
                    <TextBlock
                        Text="{Binding Dashboard.LaunchBadgeText}"
                        FontFamily="{StaticResource FontSemiBold}"
                        FontSize="11"
                        Margin="8,0,0,0"
                        VerticalAlignment="Center"
                        Foreground="{Binding Dashboard.LaunchStatusColor,
                                     Converter={StaticResource StringToBrush}}" />

                    <!--
                        Height and font are stepped down from the drawer footer's copy so the
                        button sits inside a 48px bar without setting its height. ToggleLaunch
                        is already CanExecute-gated while Starting/Stopping, so no separate
                        busy affordance is needed here — the badge text carries it.
                    -->
                    <Button
                        Content="{Binding Dashboard.LaunchButtonText}"
                        Command="{Binding Dashboard.ToggleLaunchCommand}"
                        Style="{StaticResource BaseButton}"
                        Margin="14,0,0,0"
                        Height="32"
                        Padding="14,0"
                        FontSize="12"
                        Foreground="White"
                        Background="{Binding Dashboard.LaunchButtonColor,
                                             Converter={StaticResource StringToBrush}}" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- ══════════════════ Body ══════════════════════════════════════ -->
        <!--
            Pre-pairing screens (IsShellVisible = false): the top bar row collapses to
            zero height, so this fills the entire window — same behaviour as before.
        -->

        <!--
            The transform and the opacity here are the resting state of the route
            transition; MainWindow.xaml.cs re-runs it every time Nav.Current changes so a
            new screen fades and rises into place rather than replacing the old one between
            two frames. RenderTransform rather than a margin: the views underneath are the
            heaviest layouts in the app, and this way the swap costs no layout pass.
        -->
        <ContentControl
            x:Name="ViewHost"
            Grid.Row="1"
            Content="{Binding Nav.CurrentView}">
            <ContentControl.RenderTransform>
                <TranslateTransform x:Name="ViewHostTranslate" Y="0" />
            </ContentControl.RenderTransform>
        </ContentControl>

        <!-- ══════════════════ Parameters Drawer ═════════════════════════ -->
        <!--
            Live ROS parameter tuning, slid in from the right.

            Three things about the placement are deliberate:

            • Row 1 only, not RowSpan 2. The top bar stays uncovered, so the toggle that
              opened this and the START/STOP button beside it remain reachable while it is
              open. The navigation drawer covers both rows because it is modal; this is not.

            • No backdrop. The point of live tuning is watching the camera overlay or the
              state pill react to a gain change, so the telemetry underneath has to stay
              visible *and* clickable. Adding a scrim here — for symmetry with the left
              drawer, most likely — would quietly defeat the feature.

            • Overlay, not push. The web dashboard's version adds .drawer-open and squeezes
              the layout; doing that here would take the dashboard's three-column body under
              its 984px floor and start clipping cards. It covers the right-hand column
              (Sensors / Odometry / Controller) and leaves the camera and LiDAR views clear,
              which is the pairing that matters while tuning.

            It is declared before the navigation drawer so that drawer and its backdrop
            render on top when both are open.
        -->

        <Border
            x:Name="ParametersPanel"
            Grid.Row="1"
            Width="420"
            HorizontalAlignment="Right"
            Background="{StaticResource SidebarBackground}"
            BorderBrush="{StaticResource Divider}"
            BorderThickness="1,0,0,0"
            Visibility="Collapsed">

            <Border.RenderTransform>
                <TranslateTransform x:Name="ParametersTranslate" X="420" />
            </Border.RenderTransform>

            <Border.Effect>
                <DropShadowEffect
                    Color="Black"
                    Direction="180"
                    ShadowDepth="0"
                    BlurRadius="30"
                    Opacity="0.5" />
            </Border.Effect>

            <!-- Filled in code-behind: the drawer takes its view-model by constructor
                 injection, so it cannot be new'd up by the XAML parser. -->
            <ContentControl x:Name="ParametersHost" />
        </Border>

        <!-- ══════════════════ Drawer Backdrop ═══════════════════════════ -->
        <!--
            Semi-transparent scrim behind the drawer.  Clicking it closes the drawer
            (handled in code-behind via PreviewMouseLeftButtonDown).  Both Visibility
            and Opacity are animated so the fade-out completes before the element
            collapses.
        -->

        <Border
            x:Name="DrawerBackdrop"
            Grid.Row="0" Grid.RowSpan="2"
            Background="#50000000"
            Visibility="Collapsed"
            Opacity="0" />

        <!-- ══════════════════ Sidebar Drawer ════════════════════════════ -->
        <!--
            Same content as the old fixed sidebar, now in a 280px overlay panel that
            slides in from the left.  The RenderTransform starts off-screen; the
            code-behind animates it to 0 when IsDrawerOpen becomes true and back to
            -280 when it becomes false.
        -->

        <Border
            x:Name="DrawerPanel"
            Grid.Row="0" Grid.RowSpan="2"
            Width="280"
            HorizontalAlignment="Left"
            Background="{StaticResource SidebarBackground}"
            BorderBrush="{StaticResource Divider}"
            BorderThickness="0,0,1,0"
            Visibility="Collapsed">

            <Border.RenderTransform>
                <TranslateTransform x:Name="DrawerTranslate" X="-280" />
            </Border.RenderTransform>

            <Border.Effect>
                <DropShadowEffect
                    Color="Black"
                    Direction="0"
                    ShadowDepth="0"
                    BlurRadius="30"
                    Opacity="0.5" />
            </Border.Effect>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />   <!-- close + brand -->
                    <RowDefinition Height="Auto" />   <!-- robot identity -->
                    <RowDefinition Height="*" />      <!-- nav items -->
                    <RowDefinition Height="Auto" />   <!-- launch control -->
                </Grid.RowDefinitions>

                <!-- ── Close button + brand ────────────────────────────── -->
                <Grid Grid.Row="0" Margin="24,16,8,0">
                    <TextBlock
                        Text="RISA-STUDIO"
                        FontFamily="{StaticResource FontDisplay}"
                        FontSize="14"
                        VerticalAlignment="Center">
                        <TextBlock.Foreground>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0.6">
                                <GradientStop Color="{StaticResource IceHighColor}" Offset="0.0" />
                                <GradientStop Color="{StaticResource IceMidColor}"  Offset="1.0" />
                            </LinearGradientBrush>
                        </TextBlock.Foreground>
                    </TextBlock>

                    <Button
                        HorizontalAlignment="Right"
                        VerticalAlignment="Top"
                        Command="{Binding ToggleDrawerCommand}"
                        Background="Transparent"
                        BorderThickness="0"
                        Cursor="Hand"
                        Width="36" Height="36"
                        Padding="0"
                        FocusVisualStyle="{x:Null}">
                        <TextBlock Text="✕" FontSize="16"
                                   Foreground="{StaticResource TextMuted}"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center" />
                    </Button>
                </Grid>

                <!-- ── Robot identity ──────────────────────────────────── -->
                <StackPanel Grid.Row="1" Margin="24,12,24,20">
                    <TextBlock
                        Text="{Binding Dashboard.RobotName}"
                        Style="{StaticResource CardTitle}"
                        Margin="0,0,0,0"
                        TextTrimming="CharacterEllipsis" />

                    <TextBlock
                        Text="{Binding Dashboard.RobotMdns}"
                        Style="{StaticResource MutedText}"
                        FontSize="11"
                        TextTrimming="CharacterEllipsis" />

                    <!-- Wi-Fi line: dot + SSID. Green when the internet check passes. -->
                    <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                        <Ellipse
                            Width="7" Height="7"
                            VerticalAlignment="Center"
                            controls:Animate.Fill="{Binding Dashboard.InternetOnline,
                                                    Converter={StaticResource BoolToBrush},
                                                    ConverterParameter='#00C853,#667799'}" />
                        <TextBlock
                            Text="{Binding Dashboard.ConnectedSsid}"
                            Style="{StaticResource MutedText}"
                            FontSize="11"
                            Margin="7,0,0,0"
                            TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                </StackPanel>

                <!-- ── Navigation ──────────────────────────────────────── -->
                <StackPanel Grid.Row="2" Margin="0,8,0,0">

                    <RadioButton
                        Style="{StaticResource NavButton}"
                        GroupName="DrawerNav"
                        Content="Dashboard"
                        Command="{Binding ShowDashboardCommand}"
                        IsChecked="{Binding ActiveRoute, Mode=OneWay,
                                    Converter={StaticResource EnumToBool},
                                    ConverterParameter=Dashboard}" />

                    <RadioButton
                        Style="{StaticResource NavButton}"
                        GroupName="DrawerNav"
                        Content="Controls"
                        Command="{Binding ShowControlsCommand}"
                        IsChecked="{Binding ActiveRoute, Mode=OneWay,
                                    Converter={StaticResource EnumToBool},
                                    ConverterParameter=Controls}" />

                    <RadioButton
                        Style="{StaticResource NavButton}"
                        GroupName="DrawerNav"
                        Content="Map"
                        Command="{Binding ShowSlamCommand}"
                        IsChecked="{Binding ActiveRoute, Mode=OneWay,
                                    Converter={StaticResource EnumToBool},
                                    ConverterParameter=Slam}" />

                    <RadioButton
                        Style="{StaticResource NavButton}"
                        GroupName="DrawerNav"
                        Content="Logs"
                        Command="{Binding ShowLogsCommand}"
                        IsChecked="{Binding ActiveRoute, Mode=OneWay,
                                    Converter={StaticResource EnumToBool},
                                    ConverterParameter=Logs}" />

                    <RadioButton
                        Style="{StaticResource NavButton}"
                        GroupName="DrawerNav"
                        Content="Data Logger"
                        Command="{Binding ShowDataLoggerCommand}"
                        IsChecked="{Binding ActiveRoute, Mode=OneWay,
                                    Converter={StaticResource EnumToBool},
                                    ConverterParameter=DataLogger}" />

                    <RadioButton
                        Style="{StaticResource NavButton}"
                        GroupName="DrawerNav"
                        Content="Settings"
                        Command="{Binding ShowSettingsCommand}"
                        IsChecked="{Binding ActiveRoute, Mode=OneWay,
                                    Converter={StaticResource EnumToBool},
                                    ConverterParameter=Settings}" />
                </StackPanel>

                <!-- ── Launch control ──────────────────────────────────── -->
                <!--
                    Pinned to the drawer footer so the system START/STOP is reachable
                    without dismissing the overlay. Same layout as the old sidebar footer.
                -->
                <Border
                    Grid.Row="3"
                    BorderBrush="{StaticResource Divider}"
                    BorderThickness="0,1,0,0"
                    Padding="24,18">

                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <Ellipse
                                Width="8" Height="8"
                                VerticalAlignment="Center"
                                controls:Animate.Fill="{Binding Dashboard.LaunchStatusColor,
                                                        Converter={StaticResource StringToBrush}}" />
                            <TextBlock
                                Text="{Binding Dashboard.LaunchBadgeText}"
                                FontFamily="{StaticResource FontSemiBold}"
                                FontSize="11"
                                Margin="8,0,0,0"
                                VerticalAlignment="Center"
                                Foreground="{Binding Dashboard.LaunchStatusColor,
                                                     Converter={StaticResource StringToBrush}}" />
                        </StackPanel>

                        <TextBlock
                            Text="{Binding Dashboard.LaunchStatusDetail}"
                            Style="{StaticResource MutedText}"
                            FontSize="10"
                            Margin="0,6,0,0"
                            TextWrapping="Wrap" />

                        <!--
                            Indeterminate bar during Starting/Stopping. The start path waits
                            on the ROS node graph, not just on systemd, so this can sit here
                            for the better part of a minute.
                        -->
                        <ProgressBar
                            Style="{StaticResource BusyBar}"
                            Margin="0,10,0,0"
                            Visibility="{Binding Dashboard.IsLaunchTransitioning,
                                                 Converter={StaticResource BoolToVisibility}}" />

                        <Button
                            Content="{Binding Dashboard.LaunchButtonText}"
                            Command="{Binding Dashboard.ToggleLaunchCommand}"
                            Style="{StaticResource BaseButton}"
                            Margin="0,12,0,0"
                            Foreground="White"
                            Background="{Binding Dashboard.LaunchButtonColor,
                                                 Converter={StaticResource StringToBrush}}" />

                        <TextBlock
                            Text="{Binding AppVersion, StringFormat='v{0}'}"
                            Style="{StaticResource MutedText}"
                            FontSize="10"
                            Margin="0,12,0,0"
                            HorizontalAlignment="Center" />
                    </StackPanel>
                </Border>
            </Grid>
        </Border>
    </Grid>
</Window>
