<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        RISA-Bot palette — Crimson on White.
        Content areas are pure/near-white.  #91102f is used at full strength
        as the primary accent so it cuts cleanly through the light canvas.
        The sidebar carries a clear rose tint so the chrome reads as distinctly
        branded without darkening the page.  The splash stays dark wine so
        the transition into the app feels intentional.
    -->

    <!-- ── Surfaces ──────────────────────────────────────────────────────── -->
    <Color x:Key="SplashBackgroundColor">#3D0F1E</Color>   <!-- dark wine — dramatic intro  -->
    <Color x:Key="PageBackgroundColor">#FAF5F6</Color>     <!-- barely-warm white           -->
    <Color x:Key="CardBackgroundColor">#FFFFFF</Color>     <!-- pure white cards            -->
    <Color x:Key="SidebarBackgroundColor">#F2E0E5</Color>  <!-- clearly rose sidebar / bar  -->
    <Color x:Key="DividerColor">#E0C0CC</Color>            <!-- visible rose divider        -->
    <Color x:Key="BadgeBackgroundColor">#EED5DC</Color>    <!-- blush badge                 -->

    <!-- ── Text ──────────────────────────────────────────────────────────── -->
    <!--  Near-black with a faint wine tint — high contrast on white canvas.  -->
    <Color x:Key="TextPrimaryColor">#1C0810</Color>
    <Color x:Key="TextMutedColor">#8A5865</Color>          <!-- rose-muted, readable on white -->

    <!-- ── Accents ───────────────────────────────────────────────────────── -->
    <!--  #91102f on white is WCAG AA (4.9:1).  No brightness adjustment needed. -->
    <Color x:Key="AccentBlueColor">#91102F</Color>         <!-- THE anchor — full strength  -->
    <Color x:Key="AccentTealColor">#00838F</Color>
    <Color x:Key="AccentGreenColor">#2E7D32</Color>
    <Color x:Key="AccentOrangeColor">#C84B00</Color>

    <!-- ── Brand gradient ────────────────────────────────────────────────────
         On the rose sidebar: anchor → vivid crimson → bright rose.
         On the dark splash: same gradient but seen against dark wine.        -->
    <Color x:Key="BrandPinkColor">#91102F</Color>          <!-- anchor                      -->
    <Color x:Key="BrandRoseColor">#C4163A</Color>          <!-- mid                         -->
    <Color x:Key="BrandSkyColor">#E8607A</Color>           <!-- highlight                   -->
    <Color x:Key="BrandDeepColor">#6B0E22</Color>          <!-- shadow orb on splash        -->

    <!-- Wordmark shimmer on the rose sidebar / dark splash.
         On rose sidebar (light bg) → deep wine-to-crimson reads as metal.
         On dark splash → the same dark-to-crimson gradient is still distinct. -->
    <Color x:Key="IceHighColor">#6B0E22</Color>            <!-- deep wine (readable on rose)-->
    <Color x:Key="IceMidColor">#91102F</Color>             <!-- anchor crimson              -->
    <Color x:Key="IceDeepColor">#C4163A</Color>            <!-- bright crimson              -->

    <!-- ── Status ────────────────────────────────────────────────────────── -->
    <Color x:Key="ErrorBackgroundColor">#FCEAED</Color>    <!-- pale rose card              -->
    <Color x:Key="ErrorTextColor">#C62828</Color>          <!-- deep red — contrast on white-->
    <Color x:Key="SuccessBackgroundColor">#E8F5E9</Color>  <!-- pale green card             -->
    <Color x:Key="SuccessTextColor">#2E7D32</Color>
    <Color x:Key="DisabledColor">#D4A8B5</Color>           <!-- soft rose-grey              -->
    <Color x:Key="WarningTextColor">#C84B00</Color>        <!-- deep orange — contrast on white -->

    <!-- ── Telemetry ─────────────────────────────────────────────────────── -->
    <Color x:Key="LidarNearColor">#C62828</Color>          <!-- deep red on white           -->
    <Color x:Key="LidarMidColor">#F57F17</Color>           <!-- amber on white              -->
    <Color x:Key="LidarFarColor">#2E7D32</Color>           <!-- dark green on white         -->
    <Color x:Key="LidarCenterlineColor">#00838F</Color>
    <Color x:Key="LidarGridColor">#F0D0DA</Color>          <!-- faint rose grid on white    -->

    <!-- Traffic-light lamps — use saturated tones readable on white cards.   -->
    <Color x:Key="LampRedColor">#E53935</Color>
    <Color x:Key="LampAmberColor">#FB8C00</Color>
    <Color x:Key="LampGreenColor">#43A047</Color>
    <Color x:Key="LampOffColor">#E0B8C4</Color>            <!-- visible soft rose when unlit-->

    <!-- ── Brushes ───────────────────────────────────────────────────────── -->
    <SolidColorBrush x:Key="SplashBackground"  Color="{StaticResource SplashBackgroundColor}" />
    <SolidColorBrush x:Key="PageBackground"    Color="{StaticResource PageBackgroundColor}" />
    <SolidColorBrush x:Key="CardBackground"    Color="{StaticResource CardBackgroundColor}" />
    <SolidColorBrush x:Key="SidebarBackground" Color="{StaticResource SidebarBackgroundColor}" />
    <SolidColorBrush x:Key="Divider"           Color="{StaticResource DividerColor}" />
    <SolidColorBrush x:Key="BadgeBackground"   Color="{StaticResource BadgeBackgroundColor}" />

    <SolidColorBrush x:Key="TextPrimary"       Color="{StaticResource TextPrimaryColor}" />
    <SolidColorBrush x:Key="TextMuted"         Color="{StaticResource TextMutedColor}" />

    <SolidColorBrush x:Key="AccentBlue"        Color="{StaticResource AccentBlueColor}" />
    <SolidColorBrush x:Key="AccentTeal"        Color="{StaticResource AccentTealColor}" />
    <SolidColorBrush x:Key="AccentGreen"       Color="{StaticResource AccentGreenColor}" />
    <SolidColorBrush x:Key="AccentOrange"      Color="{StaticResource AccentOrangeColor}" />

    <SolidColorBrush x:Key="ErrorBackground"   Color="{StaticResource ErrorBackgroundColor}" />
    <SolidColorBrush x:Key="ErrorText"         Color="{StaticResource ErrorTextColor}" />
    <SolidColorBrush x:Key="SuccessBackground" Color="{StaticResource SuccessBackgroundColor}" />
    <SolidColorBrush x:Key="SuccessText"       Color="{StaticResource SuccessTextColor}" />
    <SolidColorBrush x:Key="Disabled"          Color="{StaticResource DisabledColor}" />

    <SolidColorBrush x:Key="WarningText"       Color="{StaticResource WarningTextColor}" />

    <SolidColorBrush x:Key="LidarNear"         Color="{StaticResource LidarNearColor}" />
    <SolidColorBrush x:Key="LidarMid"          Color="{StaticResource LidarMidColor}" />
    <SolidColorBrush x:Key="LidarFar"          Color="{StaticResource LidarFarColor}" />
    <SolidColorBrush x:Key="LidarCenterline"   Color="{StaticResource LidarCenterlineColor}" />
    <SolidColorBrush x:Key="LidarGrid"         Color="{StaticResource LidarGridColor}" />

    <SolidColorBrush x:Key="LampRed"           Color="{StaticResource LampRedColor}" />
    <SolidColorBrush x:Key="LampAmber"         Color="{StaticResource LampAmberColor}" />
    <SolidColorBrush x:Key="LampGreen"         Color="{StaticResource LampGreenColor}" />
    <SolidColorBrush x:Key="LampOff"           Color="{StaticResource LampOffColor}" />

</ResourceDictionary>
